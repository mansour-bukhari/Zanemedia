# Zenoti MCP server credentials — copy this file to .env and fill in real values.
# Never commit .env (it's in .gitignore).

# Required. Zenoti Admin -> Settings -> Apps -> create a backend application.
ZENOTI_API_KEY=

# Optional, defaults to https://api.zenoti.com
ZENOTI_API_URL=https://api.zenoti.com

# Optional but recommended once known. Leave blank initially and run the
# zenoti-centers-list tool to discover your center GUID(s), then fill this in
# so tools don't need center_id passed on every call.
ZENOTI_CENTER_ID=
